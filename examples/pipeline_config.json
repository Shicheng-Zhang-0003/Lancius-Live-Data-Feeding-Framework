{
  "sources": [
    {
      "name": "FIRMS-MODIS-Global-24h",
      "url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/modis-c6.1/csv/MODIS_C6_1_Global_24h.csv",
      "format": "csv",
      "interval_sec": 3600,
      "parser_config": "",
      "transform_config": "filter=frp>100;project=lat,lon,frp,acq_date,confidence",
      "output_config": "http://localhost:8080/ingest/fires"
    },
    {
      "name": "FIRMS-VIIRS-US-24h",
      "url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/suomi-npp-viirs-c2/csv/SUOMI_VIIRS_C2_USA_contiguous_and_Hawaii_24h.csv",
      "format": "csv",
      "interval_sec": 1800,
      "transform_config": "filter=confidence>80;project=lat,lon,frp,acq_date,brightness",
      "output_config": "kafka://localhost:9092/fires-viirs"
    },
    {
      "name": "GBIF-Invasive-Species-CA",
      "url": "https://api.gbif.org/v1/occurrence/search?taxonKey=2684625&country=US&stateProvince=California&limit=1000",
      "format": "json",
      "interval_sec": 86400,
      "transform_config": "project=decimalLatitude,decimalLongitude,eventDate,species",
      "output_config": "s3://hsbdc-data/gbif/invasive-ca.json"
    },
    {
      "name": "Daymet-Climate-CA-Grid",
      "url": "https://daymet.ornl.gov/single-pixel/api/data?lat=37.7749&lon=-122.4194&vars=tmax,tmin,prcp,srad,dayl,vp&start=2024-01-01&end=2024-12-31",
      "format": "csv",
      "interval_sec": 86400,
      "parser_config": "skip=6",
      "transform_config": "filter=tmax>35|prcp>50",
      "output_config": "http://localhost:8080/ingest/climate-alerts"
    }
  ]
}